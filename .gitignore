.toolchains/
.gradle/
**/build/
__pycache__/
*.pyc
run/
artifacts/
checkpoints/

# Generated source-build workspaces and local credentials
source-workspace/connector/
source-workspace/connector-*/
source-workspace/gradle-cache/
source-workspace/*-project-cache/
source-workspace/xdg-*/
source-workspace/home/
source-workspace/regression-tests/classes/
.github-cli-auth/
**/reports/*.png
**/reports/*.gif
# This immutable archive is corresponding source, not a compiled artifact.
!source-workspace/artifacts/
source-workspace/artifacts/*
!source-workspace/artifacts/unified-infinity-complete-connector-fart-adapter-sources.zip

# Deliberately tracked accepted source; generated rebuild directories remain ignored.
!source-workspace/connector-four-loader/
!source-workspace/connector-four-loader/**
source-workspace/connector-four-loader/.git/
source-workspace/connector-four-loader/.gradle/
source-workspace/connector-four-loader/**/build/
source-workspace/connector-four-loader/**/classes/
source-workspace/connector-four-loader/**/test-classes/
# Digest-pinned accepted probe source/build reports, not executable artifacts.
!four-loader/clumps-probe/build/
four-loader/clumps-probe/build/*
!four-loader/clumps-probe/build/build-report.json
!four-loader/quilt-probe/build/
four-loader/quilt-probe/build/*
!four-loader/quilt-probe/build/build-report.json
source-workspace/connector-four-loader/**/.gradle/
source-workspace/connector-four-loader/**/.git/
source-workspace/connector-four-loader/**/run/
