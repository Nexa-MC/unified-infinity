+            context.getModEventBus().addListener(this::commonSetup);
+        }
+        private void commonSetup(FMLCommonSetupEvent event) {
+            setup++;
+            event.enqueueWork(() -> {
+                work++;
+                workThread = Thread.currentThread();
+                workSameContext = ForgeModLoadingContext.get() == this.context;
+            });
+        }
+    }
