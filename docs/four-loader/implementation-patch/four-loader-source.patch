+# Direct javac tests on the pinned native event owner; no Gradle or game launch.
+set -euo pipefail
+cd "$(dirname "$0")/../.."
+java_bin="${JAVA_HOME:-../../.toolchains/jdk-21.0.12.1+1}/bin"
+libs="${FORGE_FACADE_HOST_LIBRARIES:-../../run/neoforge-native/libraries}"
